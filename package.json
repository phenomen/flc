{
	"name": "flc",
	"version": "7.9.5",
	"description": "Foundry Lightweight Client",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"tauri": "tauri",
		"ui:add": "pnpx shadcn-svelte@latest add",
		"ui:update": "pnpx shadcn-svelte@latest update"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.32.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/cli": "^2.11.4",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-global-shortcut": "^2.3.2",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@tauri-apps/plugin-store": "^2.4.4",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"zod": "^4.4.3"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"esbuild"
	],
	"packageManager": "pnpm@11.22.0"
}
